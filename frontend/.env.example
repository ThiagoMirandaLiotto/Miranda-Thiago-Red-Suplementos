# URL base de la API. Por defecto "/api", que el proxy de Vite redirige a http://127.0.0.1:3000.
# No apuntar directo a http://localhost:3000: la API de la Entrega 2 no habilita CORS.
VITE_API_URL=/api

# Demora artificial (en milisegundos) antes de cada request, para mostrar los estados de carga.
# 0 = sin demora.
VITE_DEMORA_API_MS=0
